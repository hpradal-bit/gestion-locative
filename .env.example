# Supabase — valeurs publiques (URL + clé anonyme), jamais la clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — clé privée, utilisée uniquement côté serveur (Server Actions, Route Handlers).
# Ne JAMAIS préfixer par NEXT_PUBLIC_, ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envoi des emails (quittances, relances).
RESEND_API_KEY=

# Gemini — lecture IA des documents (extraction de champs depuis un bail).
# Clé gratuite sur https://aistudio.google.com/apikey. Ne JAMAIS préfixer
# par NEXT_PUBLIC_ : utilisée uniquement côté serveur (Server Actions).
GEMINI_API_KEY=
